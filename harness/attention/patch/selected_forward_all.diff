+    @cute.jit
+    def _tma_issue_value(
+        self,
+        value_cache: cute.Pointer,
+        base_ring: cute.Tensor,
+        slot: Int32,
+        lane: Int32,
+        shared_value: cute.Tensor,
+        mbar_value: cute.Pointer,
