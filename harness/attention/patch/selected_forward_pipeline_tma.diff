+                cp_async_bulk_g2s_mbar(
+                    self._segment_base_u32(shared_value, lane, Int32(block)) + Int32(64),
+                    _pointer_as_int64(value_cache, base + Int64(block * 64)),
+                    Int32(64),
+                    shared_ptr_to_u32(mbar_value),
+                )
