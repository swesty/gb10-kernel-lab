+    @cute.jit
+    def _segment_of(self, segment: Int32):
+        """Map a segment id to (row, block): 8 consecutive ids = 8 rows of one atom, same block."""
+        row = (segment % Int32(8)) + Int32(8) * (segment // Int32(32))
+        block = (segment // Int32(8)) % Int32(4)
+        return row, block
