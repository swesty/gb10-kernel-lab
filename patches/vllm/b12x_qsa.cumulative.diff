+# QSA_GATE_QUANT_PATCH: output gate + MXFP8 quantisation for o_proj, written into b12x's GEMM workspace.
+_QSA_FUSED_GATE_QUANT = __import__("os").environ.get("VLLM_QSA_FUSED_GATE_QUANT", "0") == "1"
+_QSA_GQ_NO_DEFER: set = set()
+
+
+@triton.jit
+def _qsa_gq_scale_offset(row, group, GROUPS: tl.constexpr):
+    return ((row // 128 * triton.cdiv(GROUPS, 4) + group // 4) * 512
+            + row % 32 * 16 + row // 32 % 4 * 4 + group % 4)
+
+
+@triton.jit
+def _qsa_gate_mxfp8_kernel(out_ptr, qg_ptr, Q, S, ALPHA, out_stride, qg_stride, M,
+                           HEAD_DIM: tl.constexpr, WIDTH: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = cols < WIDTH
+    valid = mask & (row < M)
+    head = cols // HEAD_DIM
+    gcols = head * (2 * HEAD_DIM) + HEAD_DIM + cols % HEAD_DIM
+    o = tl.load(out_ptr + row * out_stride + cols, mask=valid, other=0.0).to(tl.float32)
+    g = tl.load(qg_ptr + row * qg_stride + gcols, mask=valid, other=0.0).to(tl.float32)
+    sig = tl.sigmoid(g).to(tl.bfloat16).to(tl.float32)
+    v = tl.where(valid, (o * sig).to(tl.bfloat16).to(tl.float32), 0.0)
+    v2 = tl.reshape(v, (BLOCK // 32, 32))
+    amax = tl.max(tl.abs(v2), 1)
+    ratio = tl.where(amax > 0, amax / 448.0, 1.0)
+    exponent = tl.minimum(tl.maximum(tl.ceil(tl.log2(ratio)), -127.0), 127.0)
+    vals = tl.reshape((v2 / tl.exp2(exponent)[:, None]).to(tl.float8e4nv), (BLOCK,))
+    tl.store(Q + row * WIDTH + cols, vals, mask=valid)
+    groups = tl.program_id(1) * (BLOCK // 32) + tl.arange(0, BLOCK // 32)
+    tl.store(S + _qsa_gq_scale_offset(row, groups, WIDTH // 32), (exponent + 127).to(tl.uint8),
+             mask=groups < WIDTH // 32)
+    if (tl.program_id(0) == 0) & (tl.program_id(1) == 0):
+        tl.store(ALPHA, 1.0)
 
 
+class _QsaGateQuantProducer:
+    def __init__(self, flat, gate):
+        self.flat, self.gate = flat, gate
+        self.m, self.k = flat.shape
+        self.consumed = False
+
+    def __call__(self, values, scales, alpha, m):
+        padded = triton.cdiv(m, 128) * 128
+        _qsa_gate_mxfp8_kernel[(padded, triton.cdiv(self.k, 1024))](
+            self.flat, self.gate.q_gate, values, scales, alpha, self.flat.stride(0),
+            self.gate.q_gate.stride(0), m, HEAD_DIM=self.gate.head_dim, WIDTH=self.k, BLOCK=1024,
+            num_warps=4,
+        )
+        self.consumed = True
+
+
+def _qsa_gated_o_proj(layer, output, gate):
+    flat = output.flatten(-2)
+    rows, width = flat.shape
+    if (_QSA_FUSED_GATE_QUANT and isinstance(gate, _PackedGate) and rows > 80
+            and rows not in _QSA_GQ_NO_DEFER and width % 1024 == 0 and flat.stride(-1) == 1
+            and flat.dtype == torch.bfloat16 and not torch.cuda.is_current_stream_capturing()):
+        from b12x.gemm.blockscaled._preparation import B12X_MXFP8_PREQUANT
+        producer = _QsaGateQuantProducer(flat, gate)
+        dummy = torch.empty((rows, width), dtype=flat.dtype, device=flat.device)
+        token = B12X_MXFP8_PREQUANT.set(producer)
+        try:
+            projected = layer.o_proj(dummy)[0]
+        finally:
+            B12X_MXFP8_PREQUANT.reset(token)
+        if producer.consumed:
+            return projected
+        _QSA_GQ_NO_DEFER.add(rows)
+        print(f"[qsa gate-quant fusion] rows={rows} fell back; not deferring this size again", flush=True)
+    return layer.o_proj(_qsa_apply_gate(output, gate))[0]
+
+
+class _PackedGate:
+    """Marker for a gate that still lives inside the packed q_gate projection."""
+
+    __slots__ = ("q_gate", "head_dim")
+
+    def __init__(self, q_gate: torch.Tensor, head_dim: int):
+        self.q_gate = q_gate
+        self.head_dim = head_dim
+
+
+def _qsa_qk_norm_rope(q_gate, key, q_weight, k_weight, cos_sin_cache, positions, eps,
+                      num_q_heads, num_kv_heads, head_dim, rotary_dim, mrope_section):
+    n_tokens = q_gate.shape[0]
+    q_out = torch.empty((n_tokens, num_q_heads * head_dim), dtype=q_gate.dtype, device=q_gate.device)
+    k_out = torch.empty((n_tokens, num_kv_heads * head_dim), dtype=key.dtype, device=key.device)
+    if n_tokens == 0:
+        return q_out, k_out
+    has_mrope = positions.ndim == 2
+    if has_mrope:
+        positions_stride_m, positions_stride_t = positions.stride()
+        sec_h, sec_w = mrope_section[1], mrope_section[2]
+    else:
+        positions_stride_m, positions_stride_t = 0, positions.stride(0)
+        sec_h = sec_w = 0
+    half_rotary = rotary_dim // 2
+    head_block = triton.next_power_of_2(head_dim)
+    _qsa_qk_rmsnorm_rope_kernel[(n_tokens, num_q_heads + num_kv_heads)](
+        q_gate, key, q_out, k_out, q_out, q_weight, k_weight, cos_sin_cache, positions,
+        q_gate.stride(0), key.stride(0), q_out.stride(0), k_out.stride(0), q_out.stride(0),
+        cos_sin_cache.stride(0), positions_stride_m, positions_stride_t,
+        num_q_heads, num_kv_heads, head_dim, rotary_dim, half_rotary, eps,
+        norm_beta=1.0,
+        INPUT_DTYPE=tl.bfloat16 if q_gate.dtype == torch.bfloat16 else tl.float16,
+        HEAD_BLOCK=head_block, ROT_HALF_BLOCK=triton.next_power_of_2(half_rotary),
+        HAS_PASS=rotary_dim < head_dim, HAS_MROPE=has_mrope,
+        MROPE_SECTION_H=sec_h, MROPE_SECTION_W=sec_w, WRITE_GATE=False,
+        num_warps=max(1, head_block // 64), num_stages=2,
+    )
+    return q_out, k_out
+
+
+def _qsa_apply_gate(output: torch.Tensor, gate: torch.Tensor) -> torch.Tensor:
+    flat = output.flatten(-2)
+    if isinstance(gate, _PackedGate):
+        rows, width = flat.shape
+        dst = torch.empty((rows, width), dtype=flat.dtype, device=flat.device)
+        if rows:
+            _qsa_sigmoid_gate_packed_kernel[(rows, triton.cdiv(width, 1024))](
+                flat, gate.q_gate, dst, flat.stride(0), gate.q_gate.stride(0), dst.stride(0),
+                HEAD_DIM=gate.head_dim, WIDTH=width, BLOCK=1024, num_warps=4,
+            )
+        return dst
+    if not (
+        _QSA_FUSED_QK_NORM
+        and flat.dim() == 2
+        and gate.dim() == 2
+        and flat.shape == gate.shape
+        and flat.stride(-1) == 1
+        and gate.stride(-1) == 1
+        and flat.dtype == gate.dtype
+        and flat.shape[0] > 0
+    ):
+        return flat * torch.sigmoid(gate)
+    rows, width = flat.shape
+    dst = torch.empty_like(flat, memory_format=torch.contiguous_format)
+    _qsa_sigmoid_gate_kernel[(rows, triton.cdiv(width, 1024))](
+        flat, gate, dst, flat.stride(0), gate.stride(0), dst.stride(0),
+        WIDTH=width, BLOCK=1024, num_warps=4,
+    )
+    return dst
