+@triton.jit
+def _qsa_sigmoid_gate_kernel(out_ptr, gate_ptr, dst_ptr, out_stride, gate_stride, dst_stride,
+                             WIDTH: tl.constexpr, BLOCK: tl.constexpr):
+    # dst = bf16(out * bf16(sigmoid(gate))) -- same rounding as the eager
+    # ``output * torch.sigmoid(gate)`` pair, in one pass.
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = cols < WIDTH
+    o = tl.load(out_ptr + row * out_stride + cols, mask=mask, other=0.0).to(tl.float32)
+    g = tl.load(gate_ptr + row * gate_stride + cols, mask=mask, other=0.0).to(tl.float32)
+    sig = tl.sigmoid(g).to(dst_ptr.dtype.element_ty).to(tl.float32)
+    tl.store(dst_ptr + row * dst_stride + cols, (o * sig).to(dst_ptr.dtype.element_ty), mask=mask)
+
+
+def _qsa_apply_gate(output: torch.Tensor, gate: torch.Tensor) -> torch.Tensor:
+    flat = output.flatten(-2)
+    if not (
+        _QSA_FUSED_QK_NORM
+        and flat.dim() == 2
+        and gate.dim() == 2
+        and flat.shape == gate.shape
+        and flat.stride(-1) == 1
+        and gate.stride(-1) == 1
+        and flat.dtype == gate.dtype
+        and flat.shape[0] > 0
+    ):
+        return flat * torch.sigmoid(gate)
+    rows, width = flat.shape
+    dst = torch.empty_like(flat, memory_format=torch.contiguous_format)
+    _qsa_sigmoid_gate_kernel[(rows, triton.cdiv(width, 1024))](
+        flat, gate, dst, flat.stride(0), gate.stride(0), dst.stride(0),
+        WIDTH=width, BLOCK=1024, num_warps=4,
+    )
+    return dst
+
