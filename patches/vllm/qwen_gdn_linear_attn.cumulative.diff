+class _GdnNormQuantProducer:
+    """NORM_QUANT_FUSION_PATCH: fills b12x's MXFP8 workspace from the deferred gated norm."""
+
+    def __init__(self, job):
+        self.job, self.m, self.k, self.consumed = job, job["rows"], job["weight"].numel(), False
+
+    def __call__(self, values, scales, alpha, m):
+        from .gdn_norm_mxfp8 import gated_rmsnorm_mxfp8
+        j = self.job
+        gated_rmsnorm_mxfp8(j["x"], j["z"], j["weight"], j["eps"], j["live"], m, values, scales, alpha,
+                            group_size=j["group"], activation=j["activation"])
+        self.consumed = True
 
 
+def _gdn_materialize_norm(job):
+    from vllm.third_party.flash_linear_attention.ops.layernorm_guard import layer_norm_fwd
+    out, live, rows = job["out"], job["live"], job["rows"]
+    layer_norm_fwd(job["x"], job["weight"], None, job["eps"], z=job["z"],
+                   out=out[:live].view(live, -1), group_size=job["group"], norm_before_gate=True,
+                   is_rms_norm=True, activation=job["activation"])
+    if live < rows:
+        out[live:].zero_()
+
+
+def _gdn_out_proj_fused(layer, job, core_attn_out):
+    from b12x.gemm.blockscaled._preparation import B12X_MXFP8_PREQUANT
+    producer = _GdnNormQuantProducer(job)
+    token = B12X_MXFP8_PREQUANT.set(producer)
+    try:
+        output, _ = layer.out_proj(core_attn_out.flatten(-2))
+    finally:
+        B12X_MXFP8_PREQUANT.reset(token)
+    if not producer.consumed:
+        _gdn_materialize_norm(job)
+        output, _ = layer.out_proj(core_attn_out.flatten(-2))
+        _GDN_NQ_NO_DEFER.add(job["rows"])
+        print(f"[gdn norm-quant fusion] rows={job['rows']} fell back; not deferring this size again", flush=True)
+    else:
+        _GDN_NQ_STATS["fused"] += 1
+    return output
+
+
+_GDN_NQ_STATS = {"fused": 0}
+_GDN_NQ_NO_DEFER: set = set()
+
